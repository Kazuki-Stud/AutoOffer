# Server
APP_IMAGE=autooffer-server:0.1.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
APP_VERSION=0.1.0

# PostgreSQL (суперпользователь только для инициализации контейнера)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autooffer_db
DB_SUPERUSER=postgres_init
DB_SUPERUSER_PASSWORD=change_me_superuser_only_init

# Роль для Liquibase (владелец схемы, выполняет DDL)
DB_MIGRATOR_USER=autooffer_migrator
DB_MIGRATOR_PASSWORD=change_me_migrator

# Роль для Spring Boot runtime (НЕ суперпользователь; наследует app_admin -> app_write -> app_read)
DB_APP_USER=autooffer_api
DB_APP_PASSWORD=change_me_app_runtime

# Redis (cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
JWT_SECRET=replace-with-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
DEVICE_TOKEN_PEPPER=replace-with-random-hmac-pepper-secret-at-least-32-chars

# ClickHouse (OLAP)
CH_URL=http://localhost:8123
CH_DB=autooffer_olap
CH_USER=autooffer_etl
CH_PASSWORD=change_me_clickhouse_etl

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin
