<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Скопируйте сюда ваши V1__schema.sql .. V4__seed_reference.sql.
         splitStatements="false" ОБЯЗАТЕЛЕН для V2/V3/V4 из-за $$ блоков PL/pgSQL и pg_temp! -->
    <changeSet id="V1-schema" author="autooffer">
        <sqlFile path="01__schema.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>
    <changeSet id="V2-logic" author="autooffer">
        <sqlFile path="02__logic.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>
    <changeSet id="V3-roles" author="autooffer">
        <sqlFile path="03__roles.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>
    <changeSet id="V4-seed-reference" author="autooffer">
        <sqlFile path="04__seed_reference.sql" relativeToChangelogFile="true" splitStatements="false"/>
    </changeSet>
</databaseChangeLog>
