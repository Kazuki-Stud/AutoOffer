{
  "manifest_version": 3,
  "name": "AutoOffer",
  "version": "1.0.0",
  "default_locale": "ru",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html"
  }
}